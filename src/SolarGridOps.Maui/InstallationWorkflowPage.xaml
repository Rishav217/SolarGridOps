<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.InstallationWorkflowPage"
             Title="Installations">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Installation Workflow"
                   FontSize="28"
                   FontFamily="OpenSansSemibold"
                   TextColor="#8A3A12" />

            <Label Text="Project Id" FontSize="13" TextColor="#7A604D" />
            <Entry x:Name="ProjectIdEntry"
                   Placeholder="Paste project id"
                   Text="00000000-0000-0000-0000-000000000000" />

            <Border BackgroundColor="#FFF8EE" Stroke="#F2C79D" StrokeShape="RoundRectangle 14" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Create Session" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#7B3512" />
                    <Editor x:Name="WorkSummaryEditor" HeightRequest="90" Placeholder="Work summary" />
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="CompletedForDayCheckBox" />
                        <Label Text="Completed for day" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Create Session" Clicked="OnCreateSessionClicked" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Refresh Sessions" Clicked="OnRefreshClicked" />
            <Label x:Name="StatusLabel" FontSize="13" TextColor="#7A3A18" />

            <CollectionView x:Name="SessionsCollectionView" HeightRequest="420">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10" Stroke="#EBC49D" BackgroundColor="#FFFCF7" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout>
                                <Label Text="{Binding SessionDateUtc, StringFormat='Date: {0:yyyy-MM-dd HH:mm}'}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding WorkSummary}" FontSize="13" TextColor="#6F5B4A" />
                                <Label Text="{Binding IsCompletedForDay, StringFormat='Completed Today: {0}'}" FontSize="13" TextColor="#6F5B4A" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
