<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.KpiDashboardPage"
             Title="KPI Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="SolarGridOps"
                   FontFamily="OpenSansSemibold"
                   FontSize="30"
                   TextColor="#8A3A12" />

            <Label Text="Today at a glance"
                   FontSize="14"
                   TextColor="#6F4E3A" />

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#FFF6EB" Stroke="#EFC39A" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Collections" FontSize="13" TextColor="#9A643A" />
                        <Label Text="INR 6.8L" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6B2C10" />
                        <Label Text="+11.2% vs last week" FontSize="12" TextColor="#497B2C" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FFF6EB" Stroke="#EFC39A" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Installations" FontSize="13" TextColor="#9A643A" />
                        <Label Text="18" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6B2C10" />
                        <Label Text="3 pending closure" FontSize="12" TextColor="#8D5318" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFF6EB" Stroke="#EFC39A" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Panels in Stock" FontSize="13" TextColor="#9A643A" />
                        <Label Text="426" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6B2C10" />
                        <Label Text="12 low-stock alerts" FontSize="12" TextColor="#8D5318" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFF6EB" Stroke="#EFC39A" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Projects at Risk" FontSize="13" TextColor="#9A643A" />
                        <Label Text="2" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6B2C10" />
                        <Label Text="Need owner follow-up" FontSize="12" TextColor="#8D5318" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="#FFFDF8" Stroke="#EAC6A5" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Action Queue" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#7B3512" />
                    <Label Text="1. Approve panel closure for SGO-PUNE-014" />
                    <Label Text="2. Upload GPS evidence for SGO-JPR-009" />
                    <Label Text="3. Review inverter stock movement mismatch" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Refresh Snapshot" Clicked="OnRefreshSnapshotClicked" />
            <Label x:Name="StatusLabel" FontSize="13" TextColor="#7A3A18" Text="Last synced: just now" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
