<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.MainPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,20" Spacing="12">
            <Border BackgroundColor="#173A5E" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Daily Operations Overview" FontFamily="OpenSansSemibold" FontSize="22" TextColor="White" />
                    <Label x:Name="WelcomeLabel" Text="Welcome" FontSize="14" TextColor="#CFE4FF" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Active Projects" FontSize="12" TextColor="#4B6D90" />
                        <Label Text="12" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#1F4F82" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Install Sessions" FontSize="12" TextColor="#4B6D90" />
                        <Label Text="27" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#1F4F82" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Panels Assigned" FontSize="12" TextColor="#4B6D90" />
                        <Label Text="344" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#1F4F82" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Pending Closures" FontSize="12" TextColor="#4B6D90" />
                        <Label Text="3" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#B04B22" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Today's Priority Tasks" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#1A3F66" />
                    <Label Text="1. Approve closure requests pending more than 24 hours." TextColor="#35587A" />
                    <Label Text="2. Complete missing GPS proof for active installations." TextColor="#35587A" />
                    <Label Text="3. Reconcile panel movement variance before dispatch." TextColor="#35587A" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Open Help and Tools" Clicked="OnWorkspaceClicked" BackgroundColor="#1F4F82" />
            <Button Text="Sign Out" BackgroundColor="#AA4B2A" Clicked="OnSignOutClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
