<?xml version="1.0" encoding="utf-8"?>
<!-- Dev/pilot only: the API runs on plain HTTP, so cleartext traffic must be allowed for Android to reach it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
