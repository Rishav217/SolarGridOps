<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.LoginPage"
             Title="Sign In"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <Grid x:Name="RootGrid">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,1">
                    <GradientStop Color="#EAF3FF" Offset="0.0" />
                    <GradientStop Color="#CFE0F8" Offset="0.55" />
                    <GradientStop Color="#B7D1F4" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Image Source="bg_energy_wave.svg"
                   Aspect="AspectFill"
                   Opacity="0.36"
                   InputTransparent="True" />

            <Border x:Name="OrbOne"
                    WidthRequest="220"
                    HeightRequest="220"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-70,-55,0"
                    BackgroundColor="#7AB0E3"
                    Opacity="0.22"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 110"
                    InputTransparent="True" />

            <Border x:Name="OrbTwo"
                    WidthRequest="160"
                    HeightRequest="160"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="-35,0,0,-30"
                    BackgroundColor="#2E679E"
                    Opacity="0.17"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 80"
                    InputTransparent="True" />

            <VerticalStackLayout Padding="22,28" Spacing="14" VerticalOptions="Center">
                <Border BackgroundColor="#173A5E" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#2C5D8E" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                            <Label Text="SG"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="17"
                                   TextColor="White" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="SolarGridOps"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="28"
                                   TextColor="White" />
                            <Label Text="Operations Console"
                                   FontSize="13"
                                   TextColor="#D8E8FC" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="#FFFFFF" Stroke="#98B6DA" StrokeShape="RoundRectangle 18" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sign in to continue"
                               FontFamily="OpenSansSemibold"
                               FontSize="21"
                               TextColor="#14324F" />

                        <Label Text="Username or mobile"
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               TextColor="#21486E" />
                        <Border BackgroundColor="#F6FAFF" Stroke="#C2D6F0" StrokeShape="RoundRectangle 10" Padding="10,6">
                            <Entry x:Name="UsernameEntry"
                                Placeholder="Enter username"
                                Keyboard="Default"
                                TextColor="#0B1D30"
                                PlaceholderColor="#4F6F92"
                                FontSize="16"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>

                        <Label Text="Password"
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               TextColor="#21486E" />
                        <Border BackgroundColor="#F6FAFF" Stroke="#C2D6F0" StrokeShape="RoundRectangle 10" Padding="10,6">
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Enter password"
                                   IsPassword="True"
                                TextColor="#0B1D30"
                                PlaceholderColor="#4F6F92"
                                FontSize="16"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ShowPasswordCheckBox" CheckedChanged="OnShowPasswordCheckedChanged" />
                            <Label Text="Show password"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   TextColor="#35587A" />
                        </HorizontalStackLayout>

                        <Button x:Name="SignInButton"
                                Text="Sign In"
                                BackgroundColor="#1F4F82"
                                TextColor="White"
                                Clicked="OnSignInClicked" />

                        <Label Text="Sample login for pilot: 9999999999 / Admin@123"
                               FontSize="12"
                               TextColor="#5E7793" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel"
                       Text=""
                       FontSize="13"
                       TextColor="#203E5F" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
