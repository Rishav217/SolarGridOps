<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SolarGridOps.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SolarGridOps.Maui"
    Title="SolarGridOps"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate local:LoginPage}" />

    <TabBar Route="app">
        <ShellContent
            Title="Dashboard"
            Route="dashboard"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Inventory"
            Route="inventory"
            ContentTemplate="{DataTemplate local:InventoryWorkflowPage}" />

        <ShellContent
            Title="Installations"
            Route="installations"
            ContentTemplate="{DataTemplate local:InstallationWorkflowPage}" />

        <ShellContent
            Title="Workspace"
            Route="workspace"
            ContentTemplate="{DataTemplate local:NavigationHubPage}" />
    </TabBar>

</Shell>
