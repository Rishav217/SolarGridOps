<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.InstallationWorkflowPage"
             Title="Installations">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,22" Spacing="12">
            <Border BackgroundColor="#1C466F" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Installation Operations"
                           FontSize="24"
                           FontFamily="OpenSansSemibold"
                           TextColor="White" />
                    <Label Text="Track daily progress, evidence, and closure readiness."
                           FontSize="13"
                           TextColor="#CFE4FF" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Project Context" FontFamily="OpenSansSemibold" FontSize="16" TextColor="#1A3F66" />
                    <Entry x:Name="ProjectIdEntry"
                           Placeholder="Paste project id"
                           Text="00000000-0000-0000-0000-000000000000" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Create Session" FontFamily="OpenSansSemibold" FontSize="16" TextColor="#1A3F66" />
                    <Editor x:Name="WorkSummaryEditor" HeightRequest="96" Placeholder="Work summary" />
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="CompletedForDayCheckBox" />
                        <Label Text="Completed for day" VerticalOptions="Center" TextColor="#35587A" />
                    </HorizontalStackLayout>
                    <Button Text="Create Session" BackgroundColor="#1F4F82" Clicked="OnCreateSessionClicked" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Refresh Sessions" BackgroundColor="#2A6BA6" Clicked="OnRefreshClicked" />
            <Label x:Name="StatusLabel" FontSize="13" TextColor="#315779" />

            <CollectionView x:Name="SessionsCollectionView" HeightRequest="440">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10" Stroke="#BED5F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout>
                                <Label Text="{Binding SessionDateUtc, StringFormat='Date: {0:yyyy-MM-dd HH:mm}'}" FontFamily="OpenSansSemibold" TextColor="#1A3F66" />
                                <Label Text="{Binding WorkSummary}" FontSize="13" TextColor="#4B6D90" />
                                <Label Text="{Binding IsCompletedForDay, StringFormat='Completed Today: {0}'}" FontSize="13" TextColor="#4B6D90" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
