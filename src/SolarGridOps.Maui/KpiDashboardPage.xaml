<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.KpiDashboardPage"
             Title="Operations Alerts">

    <ScrollView>
        <Grid>
            <Image Source="bg_inventory_panels.svg"
                   Aspect="AspectFill"
                   Opacity="0.16"
                   InputTransparent="True" />

            <VerticalStackLayout Padding="18,14,18,22" Spacing="12">
            <Border BackgroundColor="#0A1A2F" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Operations Alerts"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="White" />
                    <Label Text="Live counts pulled directly from the database."
                           FontSize="13"
                           TextColor="#CFE4FF" />
                </VerticalStackLayout>
            </Border>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Active Projects" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="ActiveProjectsValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="23" TextColor="#1FA463" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Installation Sessions" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="InstallationSessionsValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="23" TextColor="#F5A623" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Panels Assigned" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="PanelsAssignedValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="23" TextColor="#2F6FED" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Pending Approvals" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="PendingClosuresValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="23" TextColor="#E5484D" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Tracked Assets Mix" FontFamily="OpenSansSemibold" FontSize="14" TextColor="#1A3F66" HorizontalOptions="Center" />
                    <GraphicsView x:Name="CategoryDonutGraphicsView" HeightRequest="120" WidthRequest="120" />
                    <Label x:Name="DonutLegendLabel" FontSize="11" TextColor="#4B6D90" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FDEBEB" Stroke="#D64545" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Needs Attention" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#8D1C1C" />
                    <Label x:Name="PendingApprovalsMessageLabel" Text="Loading..." TextColor="#9E1B1B" />
                    <Button Text="Open Installations"
                            BackgroundColor="#B83434"
                            TextColor="White"
                            Clicked="OnOpenInstallationsClicked" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Refresh Snapshot" BackgroundColor="#2F6FED" Clicked="OnRefreshSnapshotClicked" />
            <Label x:Name="StatusLabel" FontSize="13" TextColor="#315779" Text="Loading live data..." />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
