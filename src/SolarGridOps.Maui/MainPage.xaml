<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.MainPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label x:Name="WelcomeLabel"
                   Text="Welcome"
                   FontFamily="OpenSansSemibold"
                   FontSize="26"
                   TextColor="#8A3A12" />

            <Label Text="Live Pilot Snapshot"
                   FontSize="14"
                   TextColor="#6E3C20" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#FFF9EF" Stroke="#F1C7A0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Active Projects" FontSize="13" TextColor="#9C5D35" />
                        <Label Text="12" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6E2D10" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FFF9EF" Stroke="#F1C7A0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Install Sessions" FontSize="13" TextColor="#9C5D35" />
                        <Label Text="27" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6E2D10" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFF9EF" Stroke="#F1C7A0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Panels Assigned" FontSize="13" TextColor="#9C5D35" />
                        <Label Text="344" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6E2D10" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFF9EF" Stroke="#F1C7A0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Pending Closures" FontSize="13" TextColor="#9C5D35" />
                        <Label Text="3" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#6E2D10" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Go To Workspace"
                    Clicked="OnWorkspaceClicked" />

            <Button Text="Sign Out"
                    BackgroundColor="#B2471C"
                    Clicked="OnSignOutClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
