<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SolarGridOps.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SolarGridOps.Maui"
    Title="SolarGridOps Command"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate local:LoginPage}" />

    <TabBar Route="app">
        <ShellContent
            Title="Dashboard"
            Route="dashboard"
            Icon="icon_dashboard.svg"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Inventory"
            Route="inventory"
            Icon="icon_inventory.svg"
            ContentTemplate="{DataTemplate local:InventoryWorkflowPage}" />

        <ShellContent
            Title="Installations"
            Route="installations"
            Icon="icon_installations.svg"
            ContentTemplate="{DataTemplate local:InstallationWorkflowPage}" />

        <ShellContent
            Title="Alerts"
            Route="alerts"
            Icon="icon_kpi.svg"
            ContentTemplate="{DataTemplate local:KpiDashboardPage}" />

        <ShellContent
            Title="Help"
            Route="help"
            Icon="icon_workspace.svg"
            ContentTemplate="{DataTemplate local:NavigationHubPage}" />
    </TabBar>

</Shell>
