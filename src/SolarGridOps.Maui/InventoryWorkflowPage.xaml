<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.InventoryWorkflowPage"
             Title="Stock Management">

    <ScrollView>
        <Grid>
            <Image Source="bg_inventory_panels.svg"
                   Aspect="AspectFill"
                   Opacity="0.24"
                   InputTransparent="True" />

            <VerticalStackLayout Padding="18,14,18,22" Spacing="12">
                <Border BackgroundColor="#0A1A2F" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="icon_inventory_badge.svg" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Inventory Control"
                               FontSize="24"
                               FontFamily="OpenSansSemibold"
                               TextColor="White" />
                            <Label Text="Track assignments, stock, and panel serials with audit-ready consistency."
                               FontSize="13"
                               TextColor="#D9EAFE" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            <Border x:Name="AlertBanner"
                    IsVisible="False"
                    BackgroundColor="#FDEBEB"
                    Stroke="#D64545"
                    StrokeShape="RoundRectangle 14"
                    Padding="12">
                <Label x:Name="AlertBannerLabel"
                       Text=""
                       FontFamily="OpenSansSemibold"
                       TextColor="#9E1B1B" />
            </Border>

            <Border BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Project ID" FontFamily="OpenSansSemibold" FontSize="16" TextColor="#1A3F66" />
                    <Entry x:Name="ProjectIdEntry"
                           Placeholder="Paste project id from your project list" />
                    <Label Text="Tip: paste the project ID once, then use Refresh Panel List."
                           FontSize="12"
                           TextColor="#4B6D90" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Add Panel" FontFamily="OpenSansSemibold" FontSize="16" TextColor="#1A3F66" />
                    <Entry x:Name="SerialEntry" Placeholder="Serial number" />
                    <Entry x:Name="WattageEntry" Placeholder="Wattage" Keyboard="Numeric" />
                    <Button Text="Create Panel" BackgroundColor="#2F6FED" Clicked="OnCreatePanelClicked" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Refresh Panel List" BackgroundColor="#2A6BA6" Clicked="OnRefreshClicked" />

            <Label x:Name="StatusLabel" FontSize="13" TextColor="#12385C" />

            <CollectionView x:Name="PanelsCollectionView" HeightRequest="440">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10" Stroke="#BED5F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout>
                                <Label Text="{Binding SerialNumber}" FontFamily="OpenSansSemibold" TextColor="#1A3F66" />
                                <Label Text="{Binding Wattage, StringFormat='Wattage: {0}W'}" FontSize="13" TextColor="#4B6D90" />
                                <Label Text="{Binding Brand, StringFormat='Brand: {0}'}" FontSize="13" TextColor="#4B6D90" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
