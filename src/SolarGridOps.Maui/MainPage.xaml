<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolarGridOps.Maui.MainPage"
             Title="Dashboard">

    <ScrollView>
        <Grid>
            <Image Source="bg_customer_solar.svg"
                   Aspect="AspectFill"
                   Opacity="0.22"
                   InputTransparent="True" />

            <VerticalStackLayout Padding="18,14,18,20" Spacing="12">
            <Border BackgroundColor="#0A1A2F" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Daily Operations Overview" FontFamily="OpenSansSemibold" FontSize="22" TextColor="White" />
                    <Label x:Name="WelcomeLabel" Text="Welcome" FontSize="14" TextColor="#CFE4FF" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <Border.Shadow>
                        <Shadow Brush="#1F4F82" Opacity="0.12" Radius="10" Offset="0,3" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricCardTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="Active Projects" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="ActiveProjectsValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#1F4F82" />
                        <Label Text="Tap to view list" FontSize="11" TextColor="#7C9BC0" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <Border.Shadow>
                        <Shadow Brush="#1F4F82" Opacity="0.12" Radius="10" Offset="0,3" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricCardTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="Install Sessions" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="InstallSessionsValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#1F4F82" />
                        <Label Text="Tap to view list" FontSize="11" TextColor="#7C9BC0" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <Border.Shadow>
                        <Shadow Brush="#1F4F82" Opacity="0.12" Radius="10" Offset="0,3" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricCardTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="Panels Assigned" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="PanelsAssignedValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#1F4F82" />
                        <Label Text="Tap to view list" FontSize="11" TextColor="#7C9BC0" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="12">
                    <Border.Shadow>
                        <Shadow Brush="#1F4F82" Opacity="0.12" Radius="10" Offset="0,3" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricCardTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="Pending Closures" FontSize="12" TextColor="#4B6D90" />
                        <Label x:Name="PendingClosuresValueLabel" Text="-" FontFamily="OpenSansSemibold" FontSize="25" TextColor="#B04B22" />
                        <Label Text="Tap to view list" FontSize="11" TextColor="#7C9BC0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="#FFFFFF" Stroke="#BED5F0" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Live Status" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#1A3F66" />
                    <Label x:Name="LiveStatusLabel" Text="Loading real data from the server..." TextColor="#35587A" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Open Help and Tools" Clicked="OnWorkspaceClicked" BackgroundColor="#2F6FED" />
            <Button Text="Sign Out" BackgroundColor="#AA4B2A" Clicked="OnSignOutClicked" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
